{
  "name": "npzview",
  "displayName": "NPZ Viewer",
  "description": "View variables, shapes, and dtypes in NumPy .npy and .npz files",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:npz.preview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "npz",
        "aliases": [
          "NPZ"
        ],
        "extensions": [
          ".npz",
          ".npy"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "npz.preview",
        "displayName": "NPZ/NPY Preview",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.npz"
          },
          {
            "filenamePattern": "*.npy"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/yauzl": "^2.10.3",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "yauzl": "^3.2.0"
  },
  "publisher": "shenfy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenfy/npzview"
  },
  "bugs": {
    "url": "https://github.com/shenfy/npzview/issues"
  }
}
